---
interface Props {
  title: string;
  description?: string;
  href?: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  status?: "live" | "coming-soon";
}

const {
  title,
  description,
  href,
  thumbnail,
  thumbnailAlt = "",
  status = "live",
} = Astro.props;

const isPlaceholder = status === "coming-soon" || !href;
const Tag = isPlaceholder ? "div" : "a";
const statusLabel = status === "coming-soon" ? "Coming soon" : null;
---

<Tag
  class:list={[
    "link-card",
    "link-card--dashboard",
    isPlaceholder && "is-placeholder",
  ]}
  href={isPlaceholder ? undefined : href}
>
  <div class="link-card__thumb">
    {thumbnail ? (
      <img src={thumbnail} alt={thumbnailAlt} loading="lazy" />
    ) : (
      <span>Preview</span>
    )}
  </div>
  <div class="link-card__body">
    <h3 class="link-card__title">{title}</h3>
    {description && <p class="link-card__desc">{description}</p>}
    <div class="link-card__footer">
      <span class="link-card__status">{statusLabel ?? ""}</span>
      {!isPlaceholder && <span class="link-card__arrow" aria-hidden="true">→</span>}
    </div>
  </div>
</Tag>
