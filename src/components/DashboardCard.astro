---
interface Props {
  title: string;
  description?: string;
  href?: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  label?: string;
}

const {
  title,
  description,
  href,
  thumbnail,
  thumbnailAlt = "",
  label,
} = Astro.props;

const isPlaceholder = !href;
const Tag = isPlaceholder ? "div" : "a";
---

<Tag
  class:list={[
    "link-card",
    "link-card--dashboard",
    isPlaceholder && "is-placeholder",
  ]}
  href={isPlaceholder ? undefined : href}
>
  <div class="link-card__thumb">
    {thumbnail ? (
      <img src={thumbnail} alt={thumbnailAlt} loading="lazy" />
    ) : (
      <span>Preview</span>
    )}
  </div>
  <div class="link-card__body">
    {label && <span class="link-card__label">{label}</span>}
    <h3 class="link-card__title">{title}</h3>
    {description && <p class="link-card__desc">{description}</p>}
    <div class="link-card__footer">
      {!isPlaceholder && <span class="link-card__arrow" style="margin-left: auto;" aria-hidden="true">→</span>}
    </div>
  </div>
</Tag>
