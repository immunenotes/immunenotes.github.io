---
/**
 * DropdownLinks — a collapsible list of internal/external links.
 *
 * Built on the shared <Disclosure> (inline variant): a small underlined
 * trigger with a count pill. The link list below is this component's own.
 *
 * Props:
 *   label   required — text shown on the trigger.
 *   items   required — array of { label: string; href: string }.
 */
import Disclosure from "@components/Disclosure.astro";

interface Props {
  label: string;
  items: { label: string; href: string }[];
}

const { label, items } = Astro.props;
---

<Disclosure label={label} count={items.length} variant="inline">
  <ul class="dl__list">
    {items.map((item) => (
      <li>
        <a href={item.href} class="dl__link">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="2" y1="8" x2="13" y2="8"/>
            <polyline points="9 4 13 8 9 12"/>
          </svg>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</Disclosure>

<style>
  .dl__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.25rem;
    display: flex;
    flex-direction: column;
    border-left: 2px solid var(--border, #e0e0e0);
  }

  /* Reset global `a { border-bottom }` — scoped specificity wins. */
  .dl__link {
    display: flex;
    align-items: center;
    width: fit-content;
    gap: 0.35rem;
    line-height: 1;
    font-size: 1rem;
    color: var(--fg);
    text-decoration: none;
    border-bottom: none;
    padding: 0.15rem 0.5rem;
    transition: color 150ms var(--ease, ease);
  }

  .dl__link:hover {
    color: var(--accent-hover, var(--accent));
    border-bottom: none;
  }

  .dl__link svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
</style>
