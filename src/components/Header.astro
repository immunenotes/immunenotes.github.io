---
import Search from "@components/Search.astro";

const navItems = [
  { href: "/",             label: "Home" },
  { href: "/news/",        label: "News" },
  { href: "/people/",      label: "People" },
  { href: "/research/",    label: "Research" },
  { href: "/teaching/",    label: "Teaching" },
  { href: "/publications/",label: "Publications" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand">
      <img src="/immunenotes_logo.png" alt="Immunenotes Logo" class="site-header__logo" />
      Immunenotes
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav class="nav" id="site-nav" aria-label="Primary">
      {navItems.map((item) => {
        const itemPath = item.href.replace(/\/$/, "") || "/";
        const isCurrent = itemPath === current;
        return (
          <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>

    <Search />
  </div>
</header>

<script>
  // Mobile nav toggle. The menu and the compact search panel open into the
  // same spot under the header, so each one closes the other.
  const btn = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  const setNav = (open: boolean) => {
    nav?.classList.toggle("is-open", open);
    btn?.setAttribute("aria-expanded", String(open));
  };
  btn?.addEventListener("click", () => {
    const open = !nav?.classList.contains("is-open");
    setNav(open);
    if (open) document.dispatchEvent(new CustomEvent("nav:open"));
  });
  document.addEventListener("search:open", () => setNav(false));
</script>
