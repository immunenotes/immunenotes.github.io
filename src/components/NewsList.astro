---
import PostCard from "./PostCard.astro";

interface Props {
  posts: any[];
  pageSize?: number;
}

const { posts, pageSize = 10 } = Astro.props;
---

<div id="news-list">
  {posts.map((post, i) => (
    <div class="news-item" data-index={i}>
      <PostCard
        title={post.data.title}
        date={post.data.date}
        slug={post.id}
        image={post.data.image}
        description={post.data.description}
        sourceType={post.data.sourceType}
        source={post.data.source}
        language={post.data.language}
      />
    </div>
  ))}
</div>

<div id="load-more-wrap" hidden>
  <button id="load-more-btn" type="button" class="more-link">Load more</button>
</div>

<script define:vars={{ pageSize }}>
  const items = document.querySelectorAll(".news-item");
  const wrap = document.getElementById("load-more-wrap");
  const btn = document.getElementById("load-more-btn");
  let visible = pageSize;

  function update() {
    items.forEach((item, i) => {
      item.hidden = i >= visible;
    });
    wrap.hidden = visible >= items.length;
  }

  btn.addEventListener("click", () => {
    visible += pageSize;
    update();
  });

  update();
</script>

<style>
  #load-more-wrap {
    display: flex;
    justify-content: center;
    margin: 2.25rem 0 0.5rem;
  }
  #load-more-wrap[hidden] {
    display: none;
  }
</style>
