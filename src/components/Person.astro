---
/**
 * Person card — used on the People page.
 *
 *   <Person
 *     name="Christian Puta"
 *     role="Head of the Exercise Immunology and Health Group"
 *     mail="christian.puta@uni-jena.de
 *     image="/people/puta.jpg">
 *     Short biography in MDX / HTML...
 *   </Person>
 *
 * All fields except `name` are optional. If no image is provided, the component
 * shows a tasteful monogram placeholder made from the person's initials.
 */
interface Props {
  name: string;
  role?: string;
  mail?: string | string[];
  image?: string;
  alt?: string;
}

const { name, role, mail, image, alt } = Astro.props;
const mails = mail ? (Array.isArray(mail) ? mail : [mail]) : [];

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? "")
  .join("");
---

<article class="person">
  <div class="person__photo">
    {image ? (
      <img src={image} alt={alt ?? name} loading="lazy" />
    ) : (
      <div class="person__placeholder" aria-hidden="true">{initials}</div>
    )}
  </div>
  <div class="person__info">
    <h3 class="person__name">{name}</h3>
    {role && <p class="person__role">{role}</p>}
    {mails.map((m) => (
      <p class="person__mail">
        <span aria-hidden="true" style="font-size: 1.1em; margin-right: 0.35rem; vertical-align: middle;">✉&#xFE0E;</span><a href={`mailto:${m}`} style="vertical-align: middle;">{m}</a>
      </p>
    ))}
    <div class="person__body">
      <slot />
    </div>
  </div>
</article>
