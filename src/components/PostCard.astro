---
import LanguageFlag from "@components/LanguageFlag.astro";

interface Props {
  title: string;
  date: Date;
  slug: string;
  image?: string;
  imageFit?: "cover" | "contain";
  description?: string;
  sourceType?: string;
  source?: string;
  language?: "de" | "en";
}

const {
  title,
  date,
  slug,
  image,
  imageFit = "cover",
  description,
  sourceType,
  source,
  language,
} = Astro.props;

const dateStr = date.toLocaleDateString(language === "en" ? "en-GB" : "de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const creditLine = sourceType && source ? `${sourceType}: ${source}` : (source ?? null);
---

{/* Left out of the search index: the post's own page is the result. "all"
    also keeps the card image from becoming the listing page's search
    metadata, whose alt text (the post title) would match too. */}
<article class="post-card" data-pagefind-ignore="all">
  <a
    class:list={["post-card__link", language && "post-card__link--has-flag"]}
    href={`/news/${slug}/`}
  >
    {language && <LanguageFlag language={language} class="post-card__flag" />}
    {image && (
      <div class="post-card__img-wrap">
        <img
          src={image}
          alt={title}
          class:list={["post-card__image", imageFit === "contain" && "post-card__image--contain"]}
          loading="lazy"
        />
      </div>
    )}
    <div class="post-card__body">
      <div class="post-card__top">
        <h2 class="post-card__title">{title}</h2>
        <time class="post-card__date" datetime={date.toISOString()}>{dateStr}</time>
        {description && <p class="post-card__description">{description}</p>}
      </div>
      <div class="post-card__footer">
        {creditLine && <p class="post-card__credit">{creditLine}</p>}
        <span class="post-card__arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</article>
