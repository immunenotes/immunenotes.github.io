---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SearchHighlight from "@components/SearchHighlight.astro";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
  /**
   * Layout width variant.
   *   "prose" (default) — narrow reading column (≈720 px), ideal for text.
   *   "wide"            — wider column for iframe embeds and dashboards.
   */
  variant?: "prose" | "wide";
}

const siteName = "Immunenotes";
const defaultDescription =
  "Laboratory for Exercise Immunology and Health at the Friedrich Schiller University Jena.";

const { title, description, frontmatter, variant = "prose" } = Astro.props;

// When the layout is used from an MDX/MD page via `layout:` frontmatter,
// Astro passes the file's frontmatter via `Astro.props.frontmatter` rather
// than as top-level props. Support both call styles.
const resolvedTitle = title ?? frontmatter?.title;
const resolvedDescription =
  description ?? frontmatter?.description ?? defaultDescription;

const pageTitle = resolvedTitle ? `${resolvedTitle} | ${siteName}` : siteName;

// Small-caps label above each header-search result, derived from the first
// URL segment ("/news/foo/" → "News").
const searchLabels: Record<string, string> = {
  "": "Home",
  news: "News",
  people: "People",
  research: "Research",
  teaching: "Teaching",
  publications: "Publications",
  dashboards: "Dashboard",
  contact: "Contact",
  "privacy-policy": "Privacy Policy",
};
const searchLabel = searchLabels[Astro.url.pathname.split("/")[1] ?? ""];

const containerClasses = [
  "container",
  variant === "wide" ? "container--wide" : null,
  "prose",
]
  .filter(Boolean)
  .join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={resolvedDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/immunenotes_icon.png" />
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    {searchLabel && <meta data-pagefind-meta="label[content]" content={searchLabel} />}
  </head>
  <body>
    <Header />
    <main class="page">
      {/* Only this column is indexed by Pagefind; header and footer stay out. */}
      <article class={containerClasses} data-pagefind-body>
        <slot />
      </article>
    </main>
    <Footer />
    <SearchHighlight />
  </body>
</html>
