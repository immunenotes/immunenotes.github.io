---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sorted = [...posts].sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: sorted[index - 1] ?? null,
      older: sorted[index + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, image, photoSource } = post.data;

const dateStr = date.toLocaleDateString("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} — Immunenotes`}>
  {image && (
    <div class="post-hero">
      <img src={image} alt={title} class="post-hero__image" />
      {photoSource && <p class="post-hero__source">{photoSource}</p>}
    </div>
  )}

  <h1 class="post-title">{title}</h1>
  <time class="post-date" datetime={date.toISOString()}>{dateStr}</time>

  <nav class="post-nav" aria-label="Post navigation">
    <div class="post-nav__prev">
      {newer && (
        <a href={`/news/${newer.id}/`} class="post-nav__link">
          ← {newer.data.title}
        </a>
      )}
    </div>
    <a href="/news/" class="post-nav__up">↑ News</a>
    <div class="post-nav__next">
      {older && (
        <a href={`/news/${older.id}/`} class="post-nav__link">
          {older.data.title} →
        </a>
      )}
    </div>
  </nav>

  <div class="post-body">
    <Content />
  </div>
</BaseLayout>
