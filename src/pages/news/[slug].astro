---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sorted = [...posts].sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: sorted[index - 1] ?? null,
      older: sorted[index + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, image, sourceType, source } = post.data;

const dateStr = date.toLocaleDateString("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const creditLine = sourceType && source ? `${sourceType}: ${source}` : (source ?? null);
---

<BaseLayout title={`${title} — Immunenotes`}>
  <div class="post-header">
    {image && (
      <div class="post-header__img-wrap">
        <img src={image} alt={title} class="post-header__image" />
        {creditLine && <p class="post-img-credit post-img-credit--desktop">{creditLine}</p>}
      </div>
    )}
    <div class={`post-header__text${image ? " post-header__text--overlap" : ""}`}>
      <h1 class="post-title">{title}</h1>
      <time class="post-date" datetime={date.toISOString()}>{dateStr}</time>
    </div>
    {creditLine && image && <p class="post-img-credit post-img-credit--mobile">{creditLine}</p>}
  </div>

  <nav class="post-nav" aria-label="Post navigation">
    <div class="post-nav__prev">
      {newer && (
        <a href={`/news/${newer.id}/`} class="post-nav__link">
          ← Newer
        </a>
      )}
    </div>
    <a href="/news/" class="post-nav__up">↑ News</a>
    <div class="post-nav__next">
      {older && (
        <a href={`/news/${older.id}/`} class="post-nav__link">
          Older →
        </a>
      )}
    </div>
  </nav>

  <div class="post-body">
    <Content />
  </div>
</BaseLayout>
